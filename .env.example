
# Application
NODE_ENV=development
VELOFLOW_NAME=VeloFlow
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://veloflow:change_this_password@localhost:5432/veloflow

# Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Encryption
CREDENTIAL_ENCRYPTION_KEY=replace_with_a_64_character_hex_key

# Redis and background jobs
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# AI providers - optional
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Email provider - optional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Object storage - optional
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Logging
LOG_LEVEL=info
