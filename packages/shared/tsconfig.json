{
"extends": "../../tsconfig.base.json",
"compilerOptions": {
"target": "ES2022",
"module": "ESNext",
"moduleResolution": "Bundler",
"rootDir": "./src",
"outDir": "./dist",
"declaration": true,
"declarationMap": true,
"sourceMap": true,
"noEmit": false,
"composite": false
},
"include": [
"src/**/*.ts"
],
"exclude": [
"dist",
"node_modules"
]
}